# ====================================================================
# CARITAS LUXURY - CPANEL APACHE CONFIGURATION (.htaccess)
# ====================================================================

RewriteEngine On
RewriteBase /

# 1. Custom 404 Error Page
ErrorDocument 404 /404.html

# 2. Image Path & Asset Normalization (Handles spaces, hyphens, and encoding)
RewriteRule ^(.*)Gritty.*Jewelrysmith.*Workbench\.png$ "/wp-content/uploads/home page header picture/Gritty-Jewelrysmiths-Workbench.png" [L,NC]
RewriteRule ^(.*)Golden.*Desert.*Oasis.*\.png$ "/wp-content/uploads/home page header picture/Golden-Desert-Oasis-at-Sunset.png" [L,NC]
RewriteRule ^(.*)Artisan.*Setting.*Diamond.*Ring\.png$ "/wp-content/uploads/home page header picture/Artisan-Setting-a-Diamond-Ring.png" [L,NC]
RewriteRule ^(.*)Precision.*Lapidary.*Machine.*\.png$ "/wp-content/uploads/home page header picture/Precision-Lapidary-Machine-in-Action.png" [L,NC]
RewriteRule ^(.*)caritas-logo-dark.*perloader\.png$ "/wp-content/uploads/caritas-logo-dark-perloader.png" [L,NC]

# 3. Clean Legacy Redirections
RewriteRule ^about/?$ /about-us/ [R=301,L]
RewriteRule ^all-diamonds/?$ /diamonds/ [R=301,L]
RewriteRule ^custom-ring/?$ /create-your-own/ [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]
RewriteRule ^terms-and-conditions/?$ /terms/ [R=301,L]
RewriteRule ^privacy-policy/?$ /privacy/ [R=301,L]

# 4. Explicit Admin Routes (Zero redirect hops, serves static files directly)
RewriteRule ^admin/login/?$ /admin/login/index.html [L]
RewriteRule ^admin/?$ /admin/index.html [L]
RewriteRule ^admin/([^/]+)/?$ /admin/$1/index.html [L]
RewriteRule ^admin/([^/]+)/([^/]+)/?$ /admin/$1/$2/index.html [L]

# 5. Directory Slashing & Subdirectory HTML Serving
DirectoryIndex index.html

# If requested path is a directory containing index.html, ensure trailing slash
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)(?<!/)$ /$1/ [L,R=301]

# If requested as /path/ and /path/index.html exists, serve it
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)/$ $1/index.html [L]

# 5. Enable Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 6. Enable Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
</IfModule>

# 7. Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
