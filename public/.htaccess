# ====================================================================
# CARITAS LUXURY - CPANEL APACHE CONFIGURATION (.htaccess)
# ====================================================================

Options +FollowSymLinks -MultiViews
Options -Indexes

RewriteEngine On
RewriteBase /

# 1. Custom 404 Error Page
ErrorDocument 404 /404.html

# 2. Existing File Pass-Through (Do not rewrite existing files)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 3. Explicit Admin Routes (Directly serve static files without redirect hops)
RewriteRule ^admin/?$ /admin/index.html [L]
RewriteRule ^admin/login/?$ /admin/login/index.html [L]
RewriteRule ^admin/appointments/?$ /admin/appointments/index.html [L]
RewriteRule ^admin/categories/?$ /admin/categories/index.html [L]
RewriteRule ^admin/content/?$ /admin/content/index.html [L]
RewriteRule ^admin/customers/?$ /admin/customers/index.html [L]
RewriteRule ^admin/diamonds/?$ /admin/diamonds/index.html [L]
RewriteRule ^admin/diamonds/edit/?$ /admin/diamonds/edit/index.html [L]
RewriteRule ^admin/diamonds/new/?$ /admin/diamonds/new/index.html [L]
RewriteRule ^admin/footer/?$ /admin/footer/index.html [L]
RewriteRule ^admin/inventory/?$ /admin/inventory/index.html [L]
RewriteRule ^admin/navigation/?$ /admin/navigation/index.html [L]
RewriteRule ^admin/orders/?$ /admin/orders/index.html [L]
RewriteRule ^admin/products/?$ /admin/products/index.html [L]
RewriteRule ^admin/products/edit/?$ /admin/products/edit/index.html [L]
RewriteRule ^admin/products/new/?$ /admin/products/new/index.html [L]
RewriteRule ^admin/settings/?$ /admin/settings/index.html [L]
RewriteRule ^admin/shop/?$ /admin/shop/index.html [L]
RewriteRule ^admin/([^/]+)/?$ /admin/$1/index.html [L]
RewriteRule ^admin/([^/]+)/([^/]+)/?$ /admin/$1/$2/index.html [L]

# 4. Clean Legacy Redirections
RewriteRule ^about/?$ /about-us/ [R=301,L]
RewriteRule ^all-diamonds/?$ /diamonds/ [R=301,L]
RewriteRule ^custom-ring/?$ /create-your-own/ [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]
RewriteRule ^terms-and-conditions/?$ /terms/ [R=301,L]
RewriteRule ^privacy-policy/?$ /privacy/ [R=301,L]

# 5. Image Aliases & Asset Normalization
RewriteRule ^(.*)favicon\.png$ /images/favicon.png [L,NC]
RewriteRule ^(.*)caritas-logo-dark.*perloader\.png$ /images/caritas-logo-dark-preloader.png [L,NC]
RewriteRule ^(.*)Gritty.*Jewelrysmith.*Workbench\.png$ /images/hero/gritty-jewelrysmiths-workbench.png [L,NC]
RewriteRule ^(.*)Golden.*Desert.*Oasis.*\.png$ /images/hero/golden-desert-oasis-at-sunset.png [L,NC]
RewriteRule ^(.*)Artisan.*Setting.*Diamond.*Ring\.png$ /images/hero/artisan-setting-a-diamond-ring.png [L,NC]
RewriteRule ^(.*)Precision.*Lapidary.*Machine.*\.png$ /images/hero/precision-lapidary-machine-in-action.png [L,NC]

# 6. General Subdirectory HTML Serving
DirectoryIndex index.html

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)(?<!/)$ /$1/ [L,R=301]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ /$1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/?$ /$1/index.html [L]

# 7. Enable Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 8. Enable Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
</IfModule>

# 9. Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
