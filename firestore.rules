rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated collections for Caritas Luxury
    // These rules only govern caritas_* collections so they never
    // conflict with or overwrite any other website sharing this database.
    match /caritas_products/{productId} {
      allow read, write: if true;
    }
    match /caritas_categories/{categoryId} {
      allow read, write: if true;
    }
    match /caritas_settings/{settingId} {
      allow read, write: if true;
    }
    match /caritas_orders/{orderId} {
      allow read, write: if true;
    }
    match /caritas_customers/{customerId} {
      allow read, write: if true;
    }
    match /caritas_adminUsers/{adminId} {
      allow read, write: if true;
    }
    match /caritas_media/{mediaId} {
      allow read, write: if true;
    }
  }
}
