rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper verification functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email in ['caritas360@caritasluxury.com', 'arghyabiswas0792@gmail.com'] ||
        exists(/databases/$(database)/documents/caritas_adminUsers/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/caritas_adminUsers/$(request.auth.token.email))
      );
    }

    // Products: Public can read published products, Admins can manage
    match /caritas_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Diamonds: Public can read, Admins can manage
    match /caritas_diamonds/{diamondId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: Public can read, Admins can manage
    match /caritas_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website Content & Settings: Public read, Admin manage
    match /caritas_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media metadata: Public read, Admin manage
    match /caritas_media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Customers can create inquiries/orders, Admins can read & manage
    match /caritas_orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Customers: Public create inquiry, Admins manage
    match /caritas_customers/{customerId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin Users Directory: Authenticated can read own profile, Admins manage
    match /caritas_adminUsers/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
